PORT=4000
DB_NAME="wise-mind-os"
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET="secretwisemindos"
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secrets
IMAGEKIT_PUBLIC_KEY=placeholder_public_key
IMAGEKIT_PRIVATE_KEY=placeholder_private_key
IMAGEKIT_URL_ENDPOINT=placeholder_url_endpoint

# Required for Vercel deployment (set in Vercel project settings for the backend deployment):
# MONGODB_URI - MongoDB Atlas connection string (mongodb+srv://...)
# JWT_SECRET - Secret for signing JWT tokens
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET - For Google OAuth login
# IMAGEKIT_* - For profile picture uploads (optional for basic auth)
